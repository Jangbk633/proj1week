# OpenAI Head LLM 설정 (backend.py / frontend.py)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Anthropic API 설정 (mylggraph.py 선택적 LLM 요약용)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 로컬 Unsloth / Kanana SLM 서버 설정 (slm_server.py / summary_engine.py / summary.py)
UNSLOTH_API_KEY=YOUR_UNSLOTH_API_KEY
UNSLOTH_MODEL=kenonix/kanana-nano-2.1b-instruct-Q8_0-GGUF
LLAMA_SERVER_PORT=8891
SUMMARY_PORT=8001

# Render 원격 웹서비스 동기화 설정 (summary_engine.py)
RENDER_SERVICE_URL=
SUMMARY_SYNC_TOKEN=
